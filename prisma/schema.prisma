// Ehrin & Jay gallery — upload metadata. Files live in UploadThing;
// the engagement shoot's built-in photos live in ./photos.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Album {
  wedding
  engagement
}

enum Role {
  photographer
  guest
}

enum MediaType {
  image
  /// Animated: Live Photo, Android Motion Photo or an uploaded GIF
  animation
  video
}

enum ProcessingStatus {
  pending
  uploading
  processing
  ready
  failed
}

model Media {
  id             String    @id @default(uuid()) @db.Uuid
  album          Album
  role           Role
  uploaderName   String?   @map("uploader_name")
  /// SHA-256 of the guest's device cookie, so they can manage their uploads.
  ownerTokenHash String?   @map("owner_token_hash")
  fileKey        String    @unique @map("file_key")
  fileName       String    @map("file_name")
  /// Original upload — never replaced or deleted by processing.
  url            String
  mimeType       String?   @map("mime_type")
  /// Content fingerprint from the uploader (size + sampled SHA-256), used to
  /// spot the same photo being uploaded twice, even under another name.
  fingerprint    String?
  type           MediaType
  size           BigInt    @default(0)
  width          Int?
  height         Int?
  durationMs     Int?      @map("duration_ms")
  thumbUrl       String?   @map("thumb_url")
  largeUrl       String?   @map("large_url")
  /// Browser-friendly H.264 MP4: the motion clip for animations, or a
  /// transcode for videos the browser can't play natively (e.g. HEVC).
  videoUrl       String?   @map("video_url")
  gifUrl         String?   @map("gif_url")
  /// "live_photo" | "motion_photo" | "gif" when type = animation
  motionSource   String?   @map("motion_source")
  derivedKeys    String[]  @default([]) @map("derived_keys")
  hidden         Boolean   @default(false)
  /// Extra clockwise rotation chosen in the studio (0/90/180/270), applied
  /// on top of the file's own orientation metadata when processing.
  rotation       Int       @default(0)

  status      ProcessingStatus @default(pending)
  attempts    Int              @default(0)
  error       String?
  runAfter    DateTime         @default(now()) @map("run_after") @db.Timestamptz(6)
  lockedAt    DateTime?        @map("locked_at") @db.Timestamptz(6)
  processedAt DateTime?        @map("processed_at") @db.Timestamptz(6)

  /// Apple ContentIdentifier shared by a Live Photo's still and its MOV.
  contentId   String? @map("content_id")
  /// Set on a Live Photo's MOV once it has been merged into its still.
  /// The row (and file) is kept, but it's not shown on its own.
  companionOf String? @map("companion_of") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([album, createdAt])
  @@index([status, runAfter])
  @@index([companionOf])
  @@index([ownerTokenHash])
  @@index([album, fingerprint])
  @@map("media")
}

/// Per-album choices made in the studio.
model AlbumSettings {
  album     Album    @id
  /// Gallery item id: a media uuid, or "file:<name>" for built-in photos.
  coverId   String?  @map("cover_id")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("album_settings")
}

enum SubscriberKind {
  /// Added in the studio (the bride and groom)
  couple
  /// Left their email when uploading
  guest
}

/// People emailed when a batch of new uploads lands in a gallery.
model Subscriber {
  id               String         @id @default(uuid()) @db.Uuid
  email            String         @unique
  name             String?
  kind             SubscriberKind
  /// Guest cookie hash, so a guest isn't emailed about only their own uploads.
  ownerTokenHash   String?        @map("owner_token_hash")
  /// Secret for the one-click unsubscribe link in every email.
  unsubscribeToken String         @unique @map("unsubscribe_token")
  unsubscribedAt   DateTime?      @map("unsubscribed_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("subscribers")
}

/// Single row (id = 1): email update switches and the send cursor.
model NotificationSettings {
  id           Int       @id @default(1)
  enabled      Boolean   @default(false)
  /// Also email guests who left their address (couple always get it).
  emailGuests  Boolean   @default(true) @map("email_guests")
  /// A batch is "done" once nothing new has arrived for this long.
  quietMinutes Int       @default(10) @map("quiet_minutes")
  /// Uploads created after this have not been announced yet.
  cursor       DateTime  @default(now()) @db.Timestamptz(6)
  lastSentAt   DateTime? @map("last_sent_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("notification_settings")
}
