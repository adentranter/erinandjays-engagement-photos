# Postgres for upload metadata (same setup as vox-ii: Prisma, two URLs).
# Apply the schema with `npm run db:migrate` (prisma migrate deploy).
DATABASE_URL="postgresql://user:pass@host:5432/ehrin_jay_photos?schema=public"
DIRECT_URL="postgresql://user:pass@host:5432/ehrin_jay_photos?schema=public"

# From the UploadThing dashboard → API Keys.
UPLOADTHING_TOKEN=

# Unlocks /photographer (upload to either album, hide/delete anything).
PHOTOGRAPHER_PASSWORD=
# Optional extra entropy for the session cookie.
SESSION_SECRET=

# Optional: require guests to enter this code (e.g. printed on table cards).
GUEST_UPLOAD_CODE=

# Optional: line shown under the names on /wedding.
WEDDING_DETAILS=

# Email updates via Resend (resend.com → API Keys). Switch them on and add
# the couple's emails in /photographer. EMAIL_FROM must use a domain you've
# verified in Resend. SITE_URL is the public address used in email links.
RESEND_API_KEY=
EMAIL_FROM="Ehrin & Jay <photos@example.com>"
SITE_URL=https://example.com
# EMAIL_REPLY_TO=

# Media processing (all optional; defaults shown). The worker runs inside
# the app container and uses the media table as its queue.
# MEDIA_WORKER=on                 # "off" disables processing on this node
# MEDIA_WORKER_CONCURRENCY=1      # parallel FFmpeg jobs
# MEDIA_MAX_ATTEMPTS=3            # retries (with backoff) before "failed"
# MOTION_MAX_SECONDS=10           # longest Live/Motion Photo clip kept
# GIF_MAX_SECONDS=6
# GIF_WIDTH=480
# GIF_FPS=12
# LIVE_PHOTO_MAX_SECONDS=8        # longer MOVs are never paired as Live Photos
# VIDEO_GIF_PREVIEW_MAX_SECONDS=6 # videos this short also get a GIF
# VIDEO_TRANSCODE_MAX_SECONDS=1200 # HEVC/rotated videos up to this get an H.264 copy

# Migrations run automatically when the container starts. Set to 1 to skip.
# SKIP_MIGRATIONS=
