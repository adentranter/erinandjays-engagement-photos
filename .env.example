# Postgres for upload metadata (same setup as vox-ii: Prisma, two URLs).
# Apply the schema with `npm run db:migrate` (prisma migrate deploy).
DATABASE_URL="postgresql://user:pass@host:5432/ehrin_jay_photos?schema=public"
DIRECT_URL="postgresql://user:pass@host:5432/ehrin_jay_photos?schema=public"

# From the UploadThing dashboard → API Keys.
UPLOADTHING_TOKEN=

# Unlocks /photographer (upload to either album, hide/delete anything).
PHOTOGRAPHER_PASSWORD=
# Optional extra entropy for the session cookie.
SESSION_SECRET=

# Optional: require guests to enter this code (e.g. printed on table cards).
GUEST_UPLOAD_CODE=

# Optional: line shown under the names on /wedding.
WEDDING_DETAILS=
